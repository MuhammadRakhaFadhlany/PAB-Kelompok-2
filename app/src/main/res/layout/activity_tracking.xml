<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F7F7" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center" android:background="#F8CF59" android:text="Waktu Pengiriman" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/tvTrackingOrder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pesanan" android:textColor="#887B74" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Alamat Pengiriman" android:textColor="#40231C" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTrackingAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="12dp" android:background="#F6EBB1" android:text="Alamat" android:textColor="#40231C" />
            <id.ac.stmi.pabkel2.TrackingMapView android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Waktu Pengiriman" android:textColor="#40231C" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estimasi Tiba" android:textColor="#887B74" android:textSize="12sp" />
            <TextView android:id="@+id/tvTrackingEta" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:text="Estimasi tiba 1-3 hari" android:textColor="#F4511E" android:textSize="16sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#FFDCCB" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvStage1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pesanan diterima" android:textColor="#40231C"/><TextView android:id="@+id/tvStageDetail1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diterima" android:textColor="#F4511E"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvStage2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gudang menyiapkan suku cadang" android:textColor="#40231C"/><TextView android:id="@+id/tvStageDetail2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menunggu" android:textColor="#887B74"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvStage3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kurir dalam perjalanan" android:textColor="#40231C"/><TextView android:id="@+id/tvStageDetail3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menunggu" android:textColor="#887B74"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/tvStage4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pesanan telah sampai" android:textColor="#40231C"/><TextView android:id="@+id/tvStageDetail4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menunggu" android:textColor="#887B74"/></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnTrackingHome" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="#FFDDD0" android:text="Ke Beranda" android:textAllCaps="false" android:textColor="#F4511E" />
                <Button android:id="@+id/btnTrackingReview" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="#F4511E" android:text="Beri Ulasan" android:textAllCaps="false" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
