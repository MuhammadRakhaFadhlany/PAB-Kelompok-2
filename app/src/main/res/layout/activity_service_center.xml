<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8CF59">
    <LinearLayout android:layout_width="match_parent" android:layout_height="116dp" android:gravity="center" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Pusat Bantuan" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Butuh Bantuan?" android:textColor="#F4511E" android:textSize="14sp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#F7F7F7">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="26dp" android:paddingEnd="26dp" android:paddingTop="20dp" android:paddingBottom="26dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
                <Button android:id="@+id/btnFaq" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#FFDDD0" android:text="FAQ" android:textAllCaps="false" android:textColor="#F4511E" />
                <Button android:id="@+id/btnContactSupport" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp" android:backgroundTint="#F4511E" android:text="Hubungi Kami" android:textAllCaps="false" android:textColor="#FFFFFF" />
            </LinearLayout>
            <TextView android:id="@+id/rowCustomerService" android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:text="Layanan Pelanggan     v" android:textColor="#40231C" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/rowWebsite" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="Situs Web Geara     v" android:textColor="#40231C" android:textSize="16sp" />
            <TextView android:id="@+id/rowWhatsApp" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="WhatsApp     v" android:textColor="#40231C" android:textSize="16sp" />
            <TextView android:id="@+id/rowFacebook" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="Facebook     v" android:textColor="#40231C" android:textSize="16sp" />
            <TextView android:id="@+id/rowInstagram" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="Instagram     v" android:textColor="#40231C" android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
