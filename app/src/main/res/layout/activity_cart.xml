<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="20dp" android:background="#FFF9EF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keranjang Saya"
        android:textColor="#40231C" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="Ketuk barang untuk mengubah jumlah. Tekan lama untuk menghapus." android:textColor="#887B74" android:textSize="12sp" />
    <ListView android:id="@+id/lvCart" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp" android:divider="#E8DCD2" android:dividerHeight="8dp" />
    <TextView android:id="@+id/tvCartSubtotal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Subtotal: Rp0" android:textColor="#40231C" android:textSize="18sp" android:textStyle="bold" />
    <Button android:id="@+id/btnCheckout" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="12dp" android:backgroundTint="#F4511E" android:text="Lanjut Checkout"
        android:textAllCaps="false" android:textColor="#FFFFFF" />
</LinearLayout>
