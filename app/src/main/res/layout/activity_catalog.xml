<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="#FFF9EF">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Katalog Suku Cadang" android:textSize="25sp" android:textStyle="bold" android:textColor="#40231C"/>
<EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_login_input" android:hint="Cari nama atau kode produk..." android:paddingHorizontal="12dp"/>
<Spinner android:id="@+id/spCategory" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"/>
<ListView android:id="@+id/lvProducts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#E8DCD2" android:dividerHeight="1dp"/>
<Button android:id="@+id/btnGoCart" android:layout_width="match_parent" android:layout_height="50dp" android:backgroundTint="#F4511E" android:text="Lihat Keranjang" android:textAllCaps="false" android:textColor="#FFFFFF"/>
</LinearLayout>
