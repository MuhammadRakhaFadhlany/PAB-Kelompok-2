<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F7F7" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center" android:background="#F8CF59" android:text="Beri Ulasan" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="22dp">
            <ImageView android:id="@+id/imgReviewProduct" android:layout_width="150dp" android:layout_height="150dp" android:layout_marginTop="12dp" android:background="#D8DDDF" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Foto produk" android:scaleType="centerInside" />
            <TextView android:id="@+id/tvReviewProduct" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Nama Produk" android:textColor="#40231C" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="Bagaimana kualitas suku cadang Anda?" android:textColor="#40231C" android:textSize="17sp" />
            <RatingBar android:id="@+id/rbReviewRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:numStars="5" android:stepSize="1" android:rating="5" android:progressTint="#F4511E" android:secondaryProgressTint="#FFDDD0" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Bagikan pengalaman Anda!" android:textColor="#40231C" android:textSize="17sp" />
            <EditText android:id="@+id/etReviewText" android:layout_width="match_parent" android:layout_height="118dp" android:layout_marginTop="12dp" android:gravity="top" android:hint="Tulis ulasan..." android:inputType="textMultiLine|textCapSentences" android:padding="14dp" android:background="#F6EBB1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <Button android:id="@+id/btnCancelReview" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="#FFDDD0" android:text="Batal" android:textAllCaps="false" android:textColor="#F4511E" />
                <Button android:id="@+id/btnSendReview" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:backgroundTint="#F4511E" android:text="Kirim" android:textAllCaps="false" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
