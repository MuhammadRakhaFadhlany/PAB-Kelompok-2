<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgCheckoutProduct"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerInside"
        android:background="#F2EEE9" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/tvCheckoutProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textColor="#40231C"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCheckoutProductInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 unit x Rp0"
            android:textColor="#887B74"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCheckoutSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: Rp0"
            android:textColor="#F4511E"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
