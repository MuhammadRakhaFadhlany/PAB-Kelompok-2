<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginVertical="4dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imgCartProduct"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerInside"
        android:background="#F2EEE9" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvCartProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textColor="#40231C"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCartProductInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 unit x Rp0"
            android:textColor="#887B74"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: Rp0"
            android:textColor="#F4511E"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ubah"
        android:textColor="#F4511E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="6dp" />
</LinearLayout>
