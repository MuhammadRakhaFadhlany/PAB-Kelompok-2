<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:layout_margin="6dp" android:background="#FFFFFF" android:gravity="center_vertical">
<ImageView android:id="@+id/imgProduct" android:layout_width="76dp" android:layout_height="76dp" android:src="@android:drawable/ic_menu_gallery" android:scaleType="centerInside" android:background="#F2EEE9"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
<TextView android:id="@+id/tvProductName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nama Produk" android:textColor="#40231C" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:id="@+id/tvProductCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kode produk" android:textColor="#887B74" android:textSize="12sp"/>
<TextView android:id="@+id/tvProductPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rp0" android:textColor="#F4511E" android:textStyle="bold" android:textSize="15sp"/>
<Button android:id="@+id/btnDetail" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Lihat detail" android:textAllCaps="false" android:backgroundTint="#F4511E" android:textColor="#FFFFFF"/>
</LinearLayout></LinearLayout>
